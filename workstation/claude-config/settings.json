{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(/bin/ls:*)",
      "Bash(chmod:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(cat:*)",
      "Bash(python3:*)",
      "Bash(git clone:*)",
      "Bash(uv venv:*)",
      "Bash(uv pip install:*)",
      "Bash(uv sync:*)",
      "Bash(npm install:*)",
      "Bash(curl:*)",
      "Bash(brew install:*)",
      "Bash(mysql:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(tailscale status:*)",
      "Bash(ssh:*)",
      "Bash(ping:*)"
    ]
  },
  "model": "claude-sonnet-4-6",
  "availableModels": [
    "claude-sonnet-4-6",
    "claude-opus-4-8",
    "claude-haiku-4-5",
    "claude-fable-5"
  ],
  "hooks": {
    "SessionStart": []
  },
  "statusLine": {
    "type": "command",
    "command": "~/.config/claude-profiles/context-bar.sh"
  },
  "enabledPlugins": {
    "everything-claude-code@everything-claude-code": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "directory",
        "path": "/Users/alex/ponytail"
      }
    }
  },
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "editorMode": "vim",
  "verbose": true,
  "preferredNotifChannel": "ghostty",
  "fileCheckpointingEnabled": false
}

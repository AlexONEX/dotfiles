#!/bin/bash
# =============================================================================
# sync-engineering-skills — Sync mattpocock/skills from submodule
#
# Uses external/mattpocock-skills/ submodule as source.
# Categories: engineering, productivity, misc
#
# Usage:
#   sync-engineering-skills          # show diff
#   sync-engineering-skills --pr     # apply + create PR
# =============================================================================

set -euo pipefail

# Resolve symlinks: this script is stow-symlinked into ~/.local/bin, where a bare
# $0 makes ../../.. climb to /home (not a git repo -> "fatal: not a git repository").
# readlink -f lands on the real path inside the dotfiles repo so ../../.. is correct.
SELF="$(readlink -f "$0")"
DOTFILES_DIR="$(cd "$(dirname "$SELF")/../../.." && pwd)"
SUBMODULE="$DOTFILES_DIR/external/mattpocock-skills"
SKILLS_DIR="$DOTFILES_DIR/shared/opencode-skills"

# Categories: <upstream subpath> -> <local subdir>
declare -A CATEGORIES=(
  ["skills/engineering"]="engineering"
  ["skills/productivity"]="productivity"
  ["skills/misc"]="misc"
)

# Skills to skip from upstream
SKIP="ask-matt README.md"

# Single skills vendored from repos too big to keep as submodules:
# <dir under shared/opencode-skills> -> "<repo url> <skill path in repo>"
declare -A VENDORED=(
  ["test-audit"]="https://github.com/openclaw/openclaw.git .agents/skills/test-audit"
)
VENDOR_TMP=$(mktemp -d)
trap 'rm -rf "$VENDOR_TMP"' EXIT

# Blobless sparse clone: downloads only the skill's files, not the whole repo.
fetch_vendored() {
  local name="$1" url="$2" path="$3"
  git clone -q --depth 1 --filter=blob:none --sparse "$url" "$VENDOR_TMP/$name"
  git -C "$VENDOR_TMP/$name" sparse-checkout set --no-cone "/$path/"
}

echo "=== Sync Engineering Skills ==="
echo "  Dotfiles:  $DOTFILES_DIR"
echo "  Submodule: $SUBMODULE"

# --- Update submodule ---
echo ""
echo "Updating submodule..."
git -C "$DOTFILES_DIR" submodule update --remote external/mattpocock-skills 2>&1 | tail -1

UPSTREAM_HASH=$(git -C "$SUBMODULE" rev-parse HEAD)
echo "  Upstream commit: $UPSTREAM_HASH"

# --- Diff all categories ---
echo ""
echo "=== Diff ==="
HAS_CHANGES=false

for upstream_path in "${!CATEGORIES[@]}"; do
  local_subdir="${CATEGORIES[$upstream_path]}"
  src="$SUBMODULE/$upstream_path"
  dst="$SKILLS_DIR/$local_subdir"

  [ -d "$src" ] || { echo "  [$local_subdir] upstream dir not found, skipping"; continue; }
  mkdir -p "$dst"

  changes=$(diff -rq "$dst" "$src" 2>/dev/null | grep -v "__pycache__" || true)
  if [ -n "$changes" ]; then
    echo ""
    echo "[$local_subdir]"
    echo "$changes"
    HAS_CHANGES=true

    # Detail diff for changed files
    while IFS= read -r line; do
      # awk filter, not grep: grep exits 1 on "Only in" lines and pipefail+set -e aborts
      file=$(echo "$line" | awk '/ differ$/{print $2}')
      [ -z "$file" ] && continue
      rel="${file#$dst/}"
      [ -f "$src/$rel" ] && echo "" && echo ">> $rel" && diff -u "$dst/$rel" "$src/$rel" || true
    done <<< "$changes"
  fi
done

for name in "${!VENDORED[@]}"; do
  read -r url path <<< "${VENDORED[$name]}"
  fetch_vendored "$name" "$url" "$path"
  changes=$(diff -ru "$SKILLS_DIR/$name" "$VENDOR_TMP/$name/$path" || true)
  if [ -n "$changes" ]; then
    echo ""
    echo "[vendored: $name]"
    echo "$changes"
    HAS_CHANGES=true
  fi
done

if ! $HAS_CHANGES; then
  echo "Already up to date."
fi

# --- Apply + PR if --pr flag ---
if [ "${1:-}" = "--pr" ]; then
  echo ""
  echo "=== Creating PR ==="
  cd "$DOTFILES_DIR"

  BRANCH="sync-engineering-skills-$(date +%Y%m%d)"
  git rev-parse --verify "$BRANCH" 2>/dev/null && git branch -D "$BRANCH"
  git checkout -b "$BRANCH"

  for upstream_path in "${!CATEGORIES[@]}"; do
    local_subdir="${CATEGORIES[$upstream_path]}"
    src="$SUBMODULE/$upstream_path"
    dst="$SKILLS_DIR/$local_subdir"

    [ -d "$src" ] || continue
    mkdir -p "$dst"

    # Category dirs mirror upstream: drop skills removed/renamed there.
    # Keep your own skills out of these dirs or they get deleted here.
    for local_dir in "$dst"/*/; do
      [ -d "$local_dir" ] || continue
      [ -d "$src/$(basename "$local_dir")" ] || rm -rf "$local_dir"
    done

    for skill_dir in "$src"/*/; do
      skill=$(basename "$skill_dir")
      skip=false
      for s in $SKIP; do [ "$skill" = "$s" ] && skip=true && break; done
      $skip && continue
      rm -rf "$dst/$skill"
      cp -r "$skill_dir" "$dst/$skill"
    done
  done

  for name in "${!VENDORED[@]}"; do
    read -r _ path <<< "${VENDORED[$name]}"
    rm -rf "${SKILLS_DIR:?}/$name"
    cp -r "$VENDOR_TMP/$name/$path" "$SKILLS_DIR/$name"
  done

  git add external/mattpocock-skills "$SKILLS_DIR"
  if git diff --cached --quiet; then
    echo "No changes to commit."
    git checkout main
    git branch -D "$BRANCH"
  else
    git commit -m "chore: sync skills from mattpocock ($UPSTREAM_HASH)"
    git push -u origin "$BRANCH"
    gh pr create \
      --repo AlexONEX/dotfiles \
      --base main \
      --head "$BRANCH" \
      --title "chore: sync skills from mattpocock" \
      --body "Sync from [mattpocock/skills](https://github.com/mattpocock/skills/commit/$UPSTREAM_HASH)"
    echo "PR created!"
    git checkout main
  fi
else
  echo ""
  echo "Run with --pr to apply and create a PR."
fi
